# systemd unit for Lucky Doubles (only needed when self-hosting on a VPS —
# Vercel deployments don't use this).
# Copy to /etc/systemd/system/luckydoubles.service, adjust User/paths/port/env,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now luckydoubles

[Unit]
Description=Lucky Doubles bowling league app
After=network.target

[Service]
Type=simple
# Run as a normal unprivileged user that owns /opt/luckydoubles
User=deploy
WorkingDirectory=/opt/luckydoubles
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Pick a port that's free on your server (Caddy proxies to it)
Environment=PORT=3100
# Postgres connection string (required)
Environment=DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: pin the session secret (otherwise derived from DATABASE_URL)
# Environment=SESSION_SECRET=change-me

[Install]
WantedBy=multi-user.target
