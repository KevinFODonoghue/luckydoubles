<%- include('partials/header') %>

<div class="lane-glow" aria-hidden="true"></div>
<div class="auth-card card">
  <div class="auth-logo">🎳</div>
  <h1 class="auth-title">Join the <span class="lucky">league</span></h1>
  <p class="auth-sub">One account per bowler — you'll use it to opt in each week.</p>
  <form method="post" action="/register" class="stack">
    <label>Your name
      <input type="text" name="name" required maxlength="60" autocomplete="name" autofocus>
    </label>
    <label>Email
      <input type="email" name="email" required autocomplete="email">
    </label>
    <label>Password <span class="hint">(6+ characters)</span>
      <input type="password" name="password" required minlength="6" autocomplete="new-password">
    </label>
    <label>Bowling average <span class="hint">(optional now, required before you can sign up for a night)</span>
      <input type="number" name="average" min="0" max="300" inputmode="numeric" placeholder="e.g. 145">
    </label>
    <button type="submit" class="btn btn-primary btn-block">Create account</button>
  </form>
  <p class="auth-alt">Already registered? <a href="/login">Sign in</a></p>
</div>

<%- include('partials/footer') %>
