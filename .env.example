# Postgres connection string (Neon / Supabase / any Postgres).
# On Vercel this is injected automatically when you attach a Neon database.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Password reset email (Brevo) ---
# Without these the app still runs; "Forgot password?" just falls back to the
# admin queue on the Admin page instead of emailing a link.
#
# Brevo's free tier sends 300/day and will send from a single verified address,
# so the league does not need to own a domain — verify a normal Gmail/Outlook
# address under Brevo -> Senders, then put it in MAIL_FROM below.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Blind Doubles <league@gmail.com>

# Public origin used to build reset links. Set this in production: it is
# deliberately not read from the request Host header, which can be forged.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if unset.
# APP_URL=https://luckydoubles.vercel.app

# Optional: explicit session-cookie signing key (otherwise one is derived
# from DATABASE_URL, which is stable and fine for a league app).
# SESSION_SECRET=

# Optional: league timezone — decides when signups actually close.
# Defaults to America/New_York, and is honoured no matter what timezone the
# host runs in (Vercel runs in UTC).
# LEAGUE_TZ=America/New_York

# Optional: set to no-verify if your Postgres host's TLS cert can't be verified.
# DATABASE_SSL=no-verify
